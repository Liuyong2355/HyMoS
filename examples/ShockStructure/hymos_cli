#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="$(cd "$SCRIPT_DIR/../.." && pwd)"
ENGINE_PATH="$ROOT_DIR/build-release/bin/hymos"
CASE_LABEL="$(basename "$SCRIPT_DIR")"
RUNS_ROOT="$ROOT_DIR/workspace_runs"

export HYMOS_RUNS_ROOT="$RUNS_ROOT"

if [[ "${1:-}" == "serve" ]]; then
    mkdir -p "$RUNS_ROOT"
    RUN_DIR="$RUNS_ROOT/${CASE_LABEL}_$(date +%Y%m%d_%H%M%S)"
    mkdir -p "$RUN_DIR"
    cp "$SCRIPT_DIR/input.txt" "$RUN_DIR/input.txt"
    RUNTIME_CONTROL="$SCRIPT_DIR/.hymos_control_runtime.sh"
    export HYMOS_CONTROL_DISPLAY="$SCRIPT_DIR/hymos_control.sh"

    cat >"$SCRIPT_DIR/hymos_control.sh" <<EOF
#!/usr/bin/env bash
set -euo pipefail
cd "$RUN_DIR"
exec "$RUNTIME_CONTROL" "\$@"
EOF
    chmod +x "$SCRIPT_DIR/hymos_control.sh"

    cd "$RUN_DIR"
    exec "$ENGINE_PATH" serve "${2:-}" "$RUNTIME_CONTROL"
fi

exec "$ENGINE_PATH" "$@"
